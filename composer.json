{
    "name": "extrachill/admin-tools",
    "description": "WordPress plugin providing centralized administrative tools for the Extra Chill platform ecosystem",
    "version": "2.0.0",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Chris Huber",
            "email": "chubes@chubes.net",
            "homepage": "https://chubes.net"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "scripts": {
        "lint:php": "homeboy extension exec wordpress -- \"$HOMEBOY_EXTENSION_PATH/vendor/bin/phpcs\" --standard='$HOMEBOY_EXTENSION_PATH/rulesets/homeboy-wordpress-project.xml' .",
        "lint:fix": "homeboy extension exec wordpress -- \"$HOMEBOY_EXTENSION_PATH/vendor/bin/phpcbf\" --standard='$HOMEBOY_EXTENSION_PATH/rulesets/homeboy-wordpress-project.xml' .",
        "test": "homeboy review test extrachill-admin-tools"
    },
    "config": {
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
